<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><changefreq>yearly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/software/</loc><changefreq>yearly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ site.url }}/marketing/</loc><changefreq>yearly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ site.url }}/training/</loc><changefreq>yearly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ site.url }}/blog/</loc><changefreq>monthly</changefreq><priority>0.7</priority></url>
{% for post in site.posts %}  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod><changefreq>yearly</changefreq><priority>0.5</priority></url>
{% endfor %}</urlset>
