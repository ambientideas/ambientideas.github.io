source "https://rubygems.org"

# The site is built and deployed by .github/workflows/deploy.yml, not by
# GitHub's legacy Pages builder, so we are free to track current Jekyll
# rather than the Jekyll 3.10 that the github-pages gem pins.
gem "jekyll", "~> 4.4"

gem "html-proofer"
gem "rake"

# Windows/JRuby timezone data, harmless elsewhere.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
